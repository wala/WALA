#!/bin/sh -e

# stub post-checkout hook
# just a runner for the real post-checkout script
# if script cannot be found, exit without error
# (to not block checkouts)

REPO_ROOT_DIR="$(git rev-parse --show-toplevel)"
POST_CHECKOUT_SCRIPT="${REPO_ROOT_DIR}/config/hooks/post-checkout"

if [ -f "$POST_CHECKOUT_SCRIPT" ]; then
  # a failing fetch must never fail the checkout
  # shellcheck source=post-checkout
  "$POST_CHECKOUT_SCRIPT" || true
fi
