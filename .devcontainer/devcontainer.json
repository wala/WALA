{
  "name": "Java",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "postCreateCommand": "bash ./refresh-agent-skills.sh || echo 'Could not fetch the agent skills; see CONTRIBUTING.md for recovery instructions.'",
  "postStartCommand": "Xvfb :99 -screen 0 1024x768x24 >/tmp/xvfb.log 2>&1 &",
  "containerEnv": {
    "DISPLAY": ":99"
  },
  "customizations": {
    "jetbrains": {
      "backend": "IntelliJ",
      "plugins": ["google-java-format"]
    }
  }
}
